<Project Sdk="WixToolset.Sdk/7.0.0">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <OutputName>OfficeAgentSetup-$(ProductVersion)</OutputName>
    <OutputType>Bundle</OutputType>
    <Platforms>AnyCPU</Platforms>
    <OutputPath>..\..\</OutputPath>
    <Cultures>ja-JP</Cultures>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Bundle.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProjectReference先の$(var.<プロジェクト名>.TargetPath)をBundle.wxsから参照する -->
    <ProjectReference Include="..\MSAgentRuntime.Proj\MSAgentRuntime.wixproj">
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\OfficeAgentAddins.Proj\OfficeAgentAddins.wixproj" />
  </ItemGroup>
</Project>
