<?xml version="1.0" encoding="utf-8"?>
<!--
  OfficeAgentアドイン本体（Word/Excel/PowerPoint/Outlook/Visio/Project）のMSI。
  ClickOnceは使わず、%ProgramFiles%\OfficeAgent\<App>\ に直接ファイルを配置し、
  HKCU\Software\Microsoft\Office\<App>\Addins\<ProgId> に
  Manifest=...\<App>.vsto|vstolocal 形式でVSTOアドインとして直接登録する。

  実機検証済み: この方式でOfficeは実際にアドインをロードする。
  マニフェスト署名の自己署名証明書は、マシンの証明書ストア(TrustedPublisher/Root)へは導入しない
  （Program Filesに置くMSI配置のため信頼リストは確認されない、という仕様に基づく検証中の構成）。

  DOLPHIN.ACS等の.acsはWord/Excel/PowerPointで重複させず、共通の
  %ProgramFiles%\OfficeAgent\agents\ に1セットだけ配置する
  （AgentCharacterCatalog.vbのCandidateDirsが "..\agents" を検索候補に含む設計になっている）。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="OfficeAgent Add-ins"
           Manufacturer="OfficeAgent"
           Version="$(var.ProductVersion).0"
           UpgradeCode="5D2E8F1A-6B3C-4D9E-8A1F-2C3B4D5E6F7A"
           Scope="perMachine"
           Codepage="65001">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンのOfficeAgentが既にインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="WordAddin" Title="OfficeAgent for Word" Level="1">
      <ComponentGroupRef Id="AddinFiles_Word" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_Word" />
    </Feature>

    <Feature Id="ExcelAddin" Title="OfficeAgent for Excel" Level="1">
      <ComponentGroupRef Id="AddinFiles_Excel" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_Excel" />
    </Feature>

    <Feature Id="PowerPointAddin" Title="OfficeAgent for PowerPoint" Level="1">
      <ComponentGroupRef Id="AddinFiles_PowerPoint" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_PowerPoint" />
    </Feature>

    <Feature Id="OutlookAddin" Title="OfficeAgent for Outlook" Level="1">
      <ComponentGroupRef Id="AddinFiles_Outlook" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_Outlook" />
    </Feature>

    <Feature Id="VisioAddin" Title="OfficeAgent for Visio" Level="1">
      <ComponentGroupRef Id="AddinFiles_Visio" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_Visio" />
    </Feature>

    <Feature Id="ProjectAddin" Title="OfficeAgent for Project" Level="1">
      <ComponentGroupRef Id="AddinFiles_Project" />
      <ComponentGroupRef Id="AddinFiles_Assets" />
      <ComponentRef Id="AddinRegistry_Project" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Word本体のビルド出力一式。.acsはagents側に一本化するため除外する
         （ワイルドカードにしているのは、agents\に新しい.acsを追加した場合も
         　各アプリのフォルダに二重インストールされないようにするため） -->
    <ComponentGroup Id="AddinFiles_Word" Directory="ADDIN_WORD">
      <Files Include="..\..\src\OfficeAgent.Word.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.Word.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- Excel本体のビルド出力一式。.acsはagents側に一本化するため除外する -->
    <ComponentGroup Id="AddinFiles_Excel" Directory="ADDIN_EXCEL">
      <Files Include="..\..\src\OfficeAgent.Excel.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.Excel.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- PowerPoint本体のビルド出力一式。.acsはagents側に一本化するため除外する -->
    <ComponentGroup Id="AddinFiles_PowerPoint" Directory="ADDIN_POWERPOINT">
      <Files Include="..\..\src\OfficeAgent.PowerPoint.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.PowerPoint.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- Outlook本体のビルド出力一式。.acsはagents側に一本化するため除外する -->
    <ComponentGroup Id="AddinFiles_Outlook" Directory="ADDIN_OUTLOOK">
      <Files Include="..\..\src\OfficeAgent.Outlook.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.Outlook.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- Visio本体のビルド出力一式。.acsはagents側に一本化するため除外する -->
    <ComponentGroup Id="AddinFiles_Visio" Directory="ADDIN_VISIO">
      <Files Include="..\..\src\OfficeAgent.Visio.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.Visio.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- Project本体のビルド出力一式。.acsはagents側に一本化するため除外する -->
    <ComponentGroup Id="AddinFiles_Project" Directory="ADDIN_PROJECT">
      <Files Include="..\..\src\OfficeAgent.Project.AddIn\bin\Release\**">
        <Exclude Files="..\..\src\OfficeAgent.Project.AddIn\bin\Release\*.ACS" />
      </Files>
    </ComponentGroup>

    <!-- 共通アセット（.acs / .act）。リポジトリ直下のagents\から取得し、インストール先の
         "agents"フォルダ（ADDIN_ASSETS、Directories.wxs参照）に配置する。
         .actは*.ACSパターンに一致しないため個別に指定する -->
    <ComponentGroup Id="AddinFiles_Assets" Directory="ADDIN_ASSETS">
      <Files Include="..\..\agents\*.ACS" />
      <Files Include="..\..\agents\*.act" />
    </ComponentGroup>

    <!-- Office各アプリへのVSTOアドイン登録（HKCU、ユーザー単位）。ファイルComponentとは別にする
         （per-machineパッケージ内でHKCUデータとHKLM/ファイルデータを同一Componentに
         　混在させるとICE57で弾かれるため、AgentMPxIntl.wxsと同じ理由で分離している） -->
    <Component Id="AddinRegistry_Word" Directory="ADDIN_WORD" Guid="7A1B2C3D-4E5F-4061-8A2B-3C4D5E6F7A81">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\Word\Addins\OfficeAgent.Word.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（Word用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_WORD]OfficeAgent.Word.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>

    <Component Id="AddinRegistry_Excel" Directory="ADDIN_EXCEL" Guid="7A1B2C3D-4E5F-4062-8A2B-3C4D5E6F7A82">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\Excel\Addins\OfficeAgent.Excel.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（Excel用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_EXCEL]OfficeAgent.Excel.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>

    <Component Id="AddinRegistry_PowerPoint" Directory="ADDIN_POWERPOINT" Guid="7A1B2C3D-4E5F-4063-8A2B-3C4D5E6F7A83">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\PowerPoint\Addins\OfficeAgent.PowerPoint.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（PowerPoint用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_POWERPOINT]OfficeAgent.PowerPoint.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>

    <Component Id="AddinRegistry_Outlook" Directory="ADDIN_OUTLOOK" Guid="7A1B2C3D-4E5F-4084-8A2B-3C4D5E6F7A84">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\Outlook\Addins\OfficeAgent.Outlook.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（Outlook用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_OUTLOOK]OfficeAgent.Outlook.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>

    <Component Id="AddinRegistry_Visio" Directory="ADDIN_VISIO" Guid="7A1B2C3D-4E5F-4085-8A2B-3C4D5E6F7A85">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Visio\Addins\OfficeAgent.Visio.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（Visio用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_VISIO]OfficeAgent.Visio.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>

    <Component Id="AddinRegistry_Project" Directory="ADDIN_PROJECT" Guid="7A1B2C3D-4E5F-4086-8A2B-3C4D5E6F7A86">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Office\MS Project\Addins\OfficeAgent.Project.AddIn">
        <RegistryValue Name="FriendlyName" Type="string" Value="OfficeAgent" />
        <RegistryValue Name="Description" Type="string" Value="OfficeAgentアドイン（Project用）" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" KeyPath="yes" />
        <RegistryValue Name="Manifest" Type="string" Value="[ADDIN_PROJECT]OfficeAgent.Project.AddIn.vsto|vstolocal" />
      </RegistryKey>
    </Component>
  </Fragment>
</Wix>
